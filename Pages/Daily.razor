@page "/daily"
@inject TYB_AMI.Services.TYBAuthService AuthService

<PageTitle>Daily Exercise(s)</PageTitle>

@if (_loading){
    <p>Loading...</p>
}
else if (!AuthService.IsAuthenticated){
    <p>Please login in</p>

}
else if (_stats == null){
    <p>Couldn't load your training data. Please refresh.</p>
}
else{
    <div class="practicePageContainer">
        <h1>Day @_stats.CycleDay — Today's Training</h1>

        @if (_allDone){
            <p>You've completed all of today's exercises. Come back tomorrow!</p>
        }
        else{
            <p>Complete the following exercise(s) to continue your streak</p>
        }

        <div class="practiceContainer">
            @foreach (var game in _requiredGames){
                bool done = _completedToday.Contains(game.Id);
                <div class="practicePanel">
                    <h1>@game.DisplayName</h1>
                    <p class="practiceDesc">@game.Description</p>

                    <div class="@(done ? "completedDaily" : game.PanelCssClass)">
                        <div class="@(done ? "doneIconButton" : "iconButton")">
                            @if (done){
                                <i class="bi bi-check-circle" style="font-size:2.5em;color:#ffffff;"></i>
                            }
                            else{
                                <a href="@game.Route" class="@game.IconCssClass bi bi-play"></a>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        <p class="streak-note">
            Current streak: <strong>@_stats.Streak.Current</strong> day(s)
        </p>
    </div>
}

@code {
    private TYB_AMI.Services.UserStats? _stats;
    private bool _loading = true;
    private List<GameEntry> _requiredGames = new();
    private List<string> _completedToday = new();
    private bool _allDone = false;
    private string _serverDate = "";

    private static readonly Dictionary<string, GameEntry> GameCatalog = new(){
        ["math"]   = new GameEntry("math",   "Math",         "/math",
            "Answer 50 addition, subtraction, and multiplication problems as fast and accurately as possible.",
            "practicePlayMath", "practiceMath"),
        ["memory"] = new GameEntry("memory", "Word Memory",  "/wordmemory",
            "Spend 2 minutes memorizing 30 words, then recall as many words as you can.",
            "practicePlayMemory", "practiceMemory"),
        ["stroop"] = new GameEntry("stroop", "Stroop Test",  "/stroop",
            "Press the button with the same color as the word that is shown. Be as fast and accurate as possible.",
            "practicePlayStroop", "practiceStroop"),
    };

    protected override async Task OnInitializedAsync(){
        AuthService.OnStatsChanged += OnStatsUpdated;
        for (int i = 0; i < 50 && !AuthService.IsAuthenticated; i++){
            await Task.Delay(100);
        }
        if (AuthService.IsAuthenticated){
            _stats = await AuthService.GetStatsAsync();
            await FetchServerDate();
            UpdateDerivedState();
        }
        _loading = false;
    }

    private async Task FetchServerDate(){
        var data = await AuthService.GetServerTimeAsync();
        _serverDate = data?.ServerDate ?? "";
    }

    private void UpdateDerivedState(){
        if (_stats == null) return;

        // Build the list of required games for today's cycle day
        var requiredIds = TYB_AMI.Services.TYBAuthService
                              .RequiredGamesForCycleDay(_stats.CycleDay);

        _requiredGames = requiredIds
            .Where(id => GameCatalog.ContainsKey(id))
            .Select(id => GameCatalog[id])
            .ToList();

        // Work out which ones are already done today using the
        // server date (not local date) to avoid timezone mismatch
        var progress = _stats.DailyProgress;
        _completedToday = (progress.Date == _serverDate)
            ? progress.CompletedGames
                .Where(g => requiredIds.Contains(g))
                .ToList()
            : new List<string>();

        _allDone = requiredIds.All(id => _completedToday.Contains(id));
    }

    private async void OnStatsUpdated(){
        _stats = await AuthService.GetStatsAsync();
        UpdateDerivedState();
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose(){
        AuthService.OnStatsChanged -= OnStatsUpdated;
    }

    private record GameEntry(string Id, string DisplayName, string Route, string Description, string PanelCssClass, string IconCssClass);
}