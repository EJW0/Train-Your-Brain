@page "/wordmemory"
@inject TYBAuthService AuthService
@inject HttpClient Http
@using BlazorBootstrap

<PageTitle>Word Memorization Test</PageTitle>
<button class="rulesButton" @onclick="ShowRules">?</button>
<Modal @ref="rules"
       Title="Rules"
       UseStaticBackdrop="true"
       CloseOnEscape="false"
       IsVerticallyCentered="true"
       OnHidden="OnRulesHidden">

    <BodyTemplate>
        @if (showingInitialRules){
            <p>30 words will be shown. Memorize as many as you can in 2 minutes.</p>
            <p>Then for the next 2 minutes, type out as many words that you can remember.</p>
            <p>Click Next to start the time.</p>
        }
        else{
            <p>30 words will be shown. Memorize as many as you can in 2 minutes.</p>
            <p>Then for the next 2 minutes, type out as many words that you can remember.</p>
        }

    </BodyTemplate>

    <FooterTemplate>
        <Button Color="ButtonColor.Primary" @onclick="@(() => rules.HideAsync())">
            @if (showingInitialRules){
                <p style="margin:0">Start Quiz</p>
            }
            else{
                <p style="margin:0">Close</p>
            }

        </Button>
    </FooterTemplate>
    </Modal>
<Modal @ref="skip"
       Title="Skip Timer?"
       UseStaticBackdrop="true"
       CloseOnEscape="true"
       IsVerticallyCentered="true">

    <BodyTemplate>
        <p>Are you sure you want to skip the timer and move on to the Recall phase?</p>
    </BodyTemplate>

    <FooterTemplate>
        <Button Color="ButtonColor.Primary" @onclick="@(() => skip.HideAsync())">Cancel</Button>
        <Button Color="ButtonColor.Secondary" @onclick="ConfirmSkip">Skip</Button>
    </FooterTemplate>
</Modal>
@if (dayCompleteMessage != null){
    <Toast ToastMessage="@dayCompleteMessage" AutoHide="true" Delay="6000"  Class="position-fixed top-50 end-0 translate-middle-y me-3" Hidden="OnDayCompleteToastHidden" />
}

@if (gameState == GameState.Rules){
    <p></p>
}
else if (gameState == GameState.Memorize){
    <div class="upperInfo">
        <h3>Memorize These Words</h3>
        <p>Time Remaining: @TimeSpan.FromSeconds(memorizeSeconds).ToString(@"mm\:ss")</p>
    </div>
    <div class="memorizeHeader">
        <Button Color="ButtonColor.Secondary" @onclick="@(() => skip.ShowAsync())">Skip</Button>
    </div>
    <ul>
        <div class="wordContainer">
            @foreach (string word in game.SelectedWords){
                <div class="containerItem ">
                    @word
                </div>
            }
        </div>
    </ul>
}
else if (gameState == GameState.Recall){
    <div class="upperInfo">
        <h3>Type All The Words You Remember</h3>
        <p>Time Remaining: @TimeSpan.FromSeconds(recallSeconds).ToString(@"mm\:ss")</p>
    </div>
    <div class="memoryRecallLowerHalf">
        <div class="memoryInput">
            <EditForm Model=game OnSubmit="SubmitWord" style="width: 80%;">
                <TextInput @bind-Value="@currentInput" TextAlignment="Alignment.Center" class="wordInput"/>
                <div class="buttonGroup">
                    <Button Type="ButtonType.Submit" Color="ButtonColor.Primary">Submit</Button>
                    <Button @onclick="FinishRecall" Color="ButtonColor.Danger">Done</Button>
                </div>
            </EditForm>
        </div>

        <div class="responsesContainer memoryResponsesContainer" >
            @foreach (var word in game.UserWords){
                <p class="responses" style="padding: 1em;">@word</p>
            }
        </div>
    </div>
}
else if (gameState== GameState.TimeOver){
    <div class="resultsContainer animate__animated animate__zoomIn" style="gap: 3em; height: 60vh; justify-content: center; --animate-duration: 0.5s;">
        <h1>Time's up!</h1>
        <Button @onclick="FinishRecall" Color="ButtonColor.Primary">Show Results</Button>
    </div>
}
else if (gameState == GameState.Results){
    <Tabs EnableFadeEffect="true">
        <Tab Title="Results" Active="true">
            <Content>
                <div class="resultsContainer">
                    <h3>Final Score: @game.Score / 30</h3>
                    <div class="wordContainer">
                        @foreach (string word in game.SelectedWords){
                            <div class="containerItem">
                                @if (game.ScoredWords.Contains(word)){
                                    <div class="correctResponse">
                                        @word
                                    </div>
                                }
                                else{
                                    <div class="forgottenWord">
                                        @word
                                    </div>
                                }
                            </div>
                        }
                    </div>
            </div>
            </Content>
        </Tab>
        <Tab Title="Responses">
            <Content>
                <div class="resultsContainer">
                    <h3>Word Memorization Responses</h3>
                    <div class="responsesContainer memoryResponses">
                        @foreach (var word in game.UserWords){
                            <p class="responses" style="padding: 1em;">@word</p>
                        }
                    </div>
                </div>
            </Content>
        </Tab>
    </Tabs>
    
}

@code {
    private Modal rules = default!;
    private Modal skip = default!;
    private WordMemorization game = new ();
    private string currentInput = "";
    private int memorizeSeconds = 120;
    private int recallSeconds = 120;
    private CancellationTokenSource cts = new();
    private GameState gameState = GameState.Rules;
    private bool _modalShown;
    private TYB_AMI.Services.UserStats? _stats;
    private bool showingInitialRules = true;
    private int _cycleDayPlayed;
    private string _serverDate = "";
    private bool _dayAlreadyCompleteAtStart;
    private ToastMessage? dayCompleteMessage;
    private enum GameState
    {
        Rules,
        Memorize,
        Recall,
        TimeOver,
        Results
    }

    protected override async Task OnInitializedAsync(){
        var text = await Http.GetStringAsync("wordBank.txt");
        game.LoadWords(text.Split('\n'));
        game.SelectRandomWords(30);
        gameState = GameState.Rules;

        var statsAtStart = await AuthService.GetStatsAsync();
        var time = await AuthService.GetServerTimeAsync();
        _serverDate = time?.ServerDate ?? "";

        if (statsAtStart != null){
            _cycleDayPlayed = statsAtStart.CycleDay;
            _dayAlreadyCompleteAtStart = TYB_AMI.Services.TYBAuthService.IsDailyRequirementsMet(statsAtStart, _cycleDayPlayed, _serverDate);
        }
    }

    private async Task MemorizeTimer(){
        var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        try{
            while (memorizeSeconds > 0){
                await timer.WaitForNextTickAsync(cts.Token);
                memorizeSeconds--;
                await InvokeAsync(StateHasChanged);
            }

            gameState = GameState.Recall;
            await InvokeAsync(StateHasChanged);
            _ = RecallTimer();
        }
        catch (OperationCanceledException){
        }
        timer.Dispose();
    }

    private async Task SkipMemorize(){
        if (!cts.IsCancellationRequested){
            cts.Cancel();
        }

        gameState = GameState.Recall;
        cts = new CancellationTokenSource();
        await InvokeAsync(StateHasChanged);
        _ = RecallTimer();
    }

    private async Task RecallTimer(){
        var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        try{
            while (recallSeconds > 0){
                await timer.WaitForNextTickAsync(cts.Token);
                recallSeconds--;
                await InvokeAsync(StateHasChanged);
            }
            await FinishTimer();
        }
        catch (OperationCanceledException){
        }
        timer.Dispose();
    }

    private async Task SubmitWord(){
        string word = currentInput.Trim().ToLower();
        if (string.IsNullOrWhiteSpace(word))
            return;

        game.AddAnswer(word);
        currentInput = "";

    }

    private async Task FinishTimer(){
        gameState = GameState.TimeOver;
        await InvokeAsync(StateHasChanged);
    }

    private async Task FinishRecall(){
        game.CalculateScore();
        gameState = GameState.Results;
        await InvokeAsync(StateHasChanged);

        if (!cts.IsCancellationRequested){
            cts.Cancel();
        }
        _stats = await AuthService.SubmitScoreAsync("memory", game.Score, 0);
        AuthService.NotifyStatsChanged();

        if (!_dayAlreadyCompleteAtStart && _stats != null
            && TYB_AMI.Services.TYBAuthService.IsDailyRequirementsMet(_stats, _cycleDayPlayed, _serverDate)){
            ShowDayCompleteToast();
        }

        await InvokeAsync(StateHasChanged);
    }

    public void Dispose(){
        cts.Cancel();
        cts.Dispose();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender){
        Console.WriteLine($"OnAfterRenderAsync: firstRender={firstRender}");

        if (firstRender && !_modalShown){
            Console.WriteLine("Attempting to show modal");

            _modalShown = true;

            await Task.Yield(); 
            await rules.ShowAsync();
            Console.WriteLine("ShowAsync completed");

        }
    }

    private async Task ShowRules(){
        showingInitialRules = false;
        await rules.ShowAsync();
    }
    private async Task ConfirmSkip(){
        await skip.HideAsync();
        await SkipMemorize();
    }

    private void OnRulesHidden(){
        if (showingInitialRules){
            showingInitialRules = false;

            cts = new CancellationTokenSource();
            gameState = GameState.Memorize;
            _ = MemorizeTimer();
        }
    }

    private void ShowDayCompleteToast(){
        dayCompleteMessage = new ToastMessage{
            Type = ToastType.Success,
            Title = $"Day {_cycleDayPlayed} Completed!",
            Message = $"Your streak is now {_stats!.Streak.Current} days!"
        };
    }

    private void OnDayCompleteToastHidden(ToastEventArgs args){
        dayCompleteMessage = null;
    }

}