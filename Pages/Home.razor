@page "/"
@inject TYB_AMI.Services.TYBAuthService AuthService
@implements IDisposable
@using Radzen
@using Radzen.Blazor

<PageTitle>Home</PageTitle>
<h1>
    @if (_loading){
        <div class="loading">
            <span>Loading...</span>
            <Spinner Type="SpinnerType.Dots" Class="me-3" Color="SpinnerColor.Primary" />
        </div>
    }
</h1>

@* @foreach (var entry in mathStats.History.AsEnumerable().Reverse().Take(3)){
    <div class="recentScoreRow">
        <p id="margin0">@entry.Date</p>
        <p id="margin0">@entry.Score</p>
        <p id="margin0">@FormatTime(entry.TimeSeconds)</p>
    </div>
} *@

@if (!_loading && AuthService.IsAuthenticated){
    @if (_statsLoading){
        <div class="loading">
            <p>Loading your stats...</p>
            <Spinner Type="SpinnerType.Dots" Class="me-3" Color="SpinnerColor.Primary" />
        </div>
    }
    else if (_stats != null){
        var stats = _stats;
        <div class=homeContainer>
            <div id="topHalf">
                <div class="streakPanel">
                    <div class="streakContainer">
                        <div class="streakLeft">
                            <p class="currentStreak">Current streak</p> 
                            <div class="streakDay">
                                <div class="streakIcon bi bi-fire"></div>
                                <p class="streakNum"><span>@stats.Streak.Current</span> day</p>
                            </div>
                        </div>

                        <div class="streakRight">
                            <p class="currentStreak">Longest streak</p> 
                            <div class="streakDay">
                                <div class="streakIcon bi bi-star-fill"></div>
                                <p class="streakNum"><span>@stats.Streak.Longest</span> day</p>
                            </div>
                        </div>
                    </div>

                    @* <a href="/daily" class="viewDailyGames">
                            Begin Day @stats.CycleDay
                    </a> *@

                    @if (!_todayComplete){
                        <a href="/daily" class="viewDailyGames">
                            Begin Day @stats.CycleDay
                        </a>
                    }
                    else{
                        <p class="viewDailyGames">
                            Day Completed
                        </p>
                    }
                </div>

                <div class="calendar">
                    <RadzenDatePicker
                        @key="_calendarKey"
                        Inline="true"
                        DateRender="@OnDateRender"
                        ReadOnly="true"
                        ShowCalendarWeek="false"
                        TValue="DateTime?" />
                </div>   
            </div>
            
            <div id="bottomHalf">
                <p id="yourPerformance">Your Performance</P>
                <div class="gamePanels">
                    <div class="mathPanel">
                        <div class="panelRow1">
                            <p class="panelTitle" id="mathText">Math</p>
                        </div>
                        @if (stats.Games.TryGetValue("math", out var mathStats)){
                            <div class="panelRow2">
                                <div class="panelHalf1">
                                    <p class="numDesc" id="mathAvg">Avg Time</p>
                                    @if (mathStats.History.Count > 0){
                                        <p class="panelNum" id="mathNum">@FormatTime((int)mathStats.History.Average(h => h.TimeSeconds))</p>
                                    }
                                    else{
                                        <p class="panelNum" id="mathNum">—:——</p>
                                    }
                                </div>
                                <div class="panelHalf2">
                                    <p class="numDesc" id="mathAvg">Avg Accuracy</p>
                                    <p class="panelNum" id="mathNum">—%</p>
                                </div>
                            </div>

                            <div class="panelRow3">
                                <p class="recentScoresTitle" id="mathRecentScoreTitle">Recent scores</p>
                                @{ rowCount = 0; }
                                @if (mathStats.History.Count > 0){
                                    @foreach (var entry in mathStats.History.AsEnumerable().Reverse().Take(3)){
                                        <div class="recentScoreRow">
                                            <p id="margin0">@entry.Date</p>
                                            <p id="margin0">@FormatTime(entry.TimeSeconds)</p>
                                        </div>
                                        { rowCount += 1; }
                                    }
                                    @for (int i = 0; i < 3 - rowCount; i++){
                                        <div class="recentScoreRow">
                                            <p id="margin0">—</p>
                                            <p id="margin0">—</p>
                                        </div>
                                    }
                                }
                                else{
                                    @for (int i = 0; i < 3; i++){
                                        <div class="recentScoreRow">
                                            <p id="margin0">—</p>
                                            <p id="margin0">—</p>
                                        </div>
                                    }
                                }
                            </div>
                        }
                    </div>

                    <div class="memoryPanel">
                        <div class="panelRow1">
                            <p class="panelTitle" id="mathText">Memory</p>
                        </div>
                        @if (stats.Games.TryGetValue("memory", out var memoryStats)){
                            <div class="panelRow2">
                                <div class="panelHalf1">
                                    <p class="numDesc" id="memoryAvg">Average score</p>
                                    @if (memoryStats.GamesPlayed != 0){
                                        <p class="panelNum" id="memoryNum">@(memoryStats.TotalScore / memoryStats.GamesPlayed)</p>
                                    }
                                    else{
                                        <p class="panelNum" id="memoryNum">—:——</p>
                                    }
                                </div>
                                <div class="panelHalf2">
                                    <p class="numDesc" id="memoryAvg">Best score</p>
                                    <p class="panelNum" id="memoryNum">—%</p>
                                </div>
                            </div>

                            <div class="panelRow3">
                                <p class="recentScoresTitle" id="memoryRecentScoreTitle">Recent scores</p>
                                @{ rowCount = 0; }
                                @if (memoryStats.History.Count > 0){
                                    @foreach (var entry in memoryStats.History.AsEnumerable().Reverse().Take(3)){
                                        <div class="recentScoreRow">
                                            <p id="margin0">@entry.Date</p>
                                            <p id="margin0">@entry.Score</p>
                                        </div>
                                        { rowCount += 1; }
                                    }
                                    @for (int i = 0; i < 3 - rowCount; i++){
                                        <div class="recentScoreRow">
                                            <p id="margin0">—</p>
                                            <p id="margin0">—</p>
                                        </div>
                                    }
                                }
                                else{
                                    @for (int i = 0; i < 3; i++){
                                        <div class="recentScoreRow">
                                            <p id="margin0">—</p>
                                            <p id="margin0">—</p>
                                        </div>
                                    }
                                }
                            </div>
                        }
                    </div>

                    <div class="stroopPanel">
                        <div class="panelRow1">
                            <p class="panelTitle" id="stroopText">Stroop Test</p>
                        </div>
                        @if (stats.Games.TryGetValue("stroop", out var stroopStats)){
                            <div class="panelRow2">
                                <div class="panelHalf1">
                                    <p class="numDesc" id="stroopAvg">Avg Time</p>
                                    @if (stroopStats.History.Count > 0){
                                        <p class="panelNum" id="mathNum">@FormatTime((int)stroopStats.History.Average(h => h.TimeSeconds))</p>
                                    }
                                    else{
                                        <p class="panelNum" id="stroopNum">—:——</p>
                                    }
                                </div>
                                <div class="panelHalf2">
                                    <p class="numDesc" id="mathAvg">Avg Accuracy</p>
                                    <p class="panelNum" id="stroopNum">—%</p>
                                </div>
                            </div>

                            <div class="panelRow3">
                                <p class="recentScoresTitle" id="mathRecentScoreTitle">Recent scores</p>
                                @{ rowCount = 0; }
                                @if (stroopStats.History.Count > 0){
                                    @foreach (var entry in stroopStats.History.AsEnumerable().Reverse().Take(3)){
                                        <div class="recentScoreRow">
                                            <p id="margin0">@entry.Date</p>
                                            <p id="margin0">@FormatTime(entry.TimeSeconds)</p>
                                        </div>
                                        { rowCount += 1; }
                                    }
                                    @for (int i = 0; i < 3 - rowCount; i++){
                                        <div class="recentScoreRow">
                                            <p id="margin0">—</p>
                                            <p id="margin0">—</p>
                                        </div>
                                    }
                                }
                                else{
                                    @for (int i = 0; i < 3; i++){
                                        <div class="recentScoreRow">
                                            <p id="margin0">—</p>
                                            <p id="margin0">—</p>
                                        </div>
                                    }
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
}

@code {
    private int rowCount = 0;
    private bool _loading = true;
    private bool _statsLoading = true;
    private TYB_AMI.Services.UserStats? _stats;
    private HashSet<string> _fullyCompletedDates = new();
    private int _calendarKey = 0;
    private bool _todayComplete = false;
    private string _serverDate = "";

    protected override async Task OnInitializedAsync(){
        AuthService.OnStatsChanged += OnStatsUpdated;
        for (int i = 0; i < 50 && !AuthService.IsAuthenticated; i++){
            await Task.Delay(100);
        }
        _loading = false;
        if (AuthService.IsAuthenticated){
            _stats = await AuthService.GetStatsAsync();
            BuildCompletedDates();
            await FetchServerDate();
            UpdateTodayComplete();
        }
        _statsLoading = false;
    }

    private void BuildCompletedDates(){
        if (_stats == null) return;
        _fullyCompletedDates = new HashSet<string>(_stats.CompletedDates);
    }

    private void OnDateRender(DateRenderEventArgs args){
        var dateStr = args.Date.ToString("yyyy-MM-dd");

        if (_fullyCompletedDates.Contains(dateStr))
            args.Attributes["class"] = "calendar-day-completed";

        args.Disabled = true;
    }

    private async void OnStatsUpdated(){
        _stats = await AuthService.GetStatsAsync();
        await FetchServerDate();
        UpdateTodayComplete();  
        BuildCompletedDates();
        _calendarKey++;    
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose(){
        AuthService.OnStatsChanged -= OnStatsUpdated;
    }

    private string FormatTime(int seconds){
        if (seconds == 0) return "—";
        int m = seconds / 60;
        int s = seconds % 60;
        return m > 0 ? $"{m}m {s:D2}s" : $"{s}s";
    }
    private async Task FetchServerDate(){
        var data = await AuthService.GetServerTimeAsync();
        _serverDate = data?.ServerDate ?? "";
    }

    private void UpdateTodayComplete(){
        if (_stats == null || string.IsNullOrEmpty(_serverDate)){
            _todayComplete = false;
            return;
        }
        _todayComplete = _stats.CompletedDates.Contains(_serverDate);
    }
}