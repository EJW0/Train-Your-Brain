@page "/stroop"
@using BlazorBootstrap
@using Microsoft.AspNetCore.Components.Web
@implements IAsyncDisposable
@inject TYB_AMI.Services.TYBAuthService AuthService
@inject IJSRuntime JS

<PageTitle>Stroop Test</PageTitle>
<Modal @ref="rules"
           Title="Rules"
           UseStaticBackdrop="true"
           CloseOnEscape="false"
           IsVerticallyCentered="true"
           OnHidden="OnRulesHidden">

        <BodyTemplate>
            <p>Select the <strong>color</strong> of the word, not what the word says.</p>
            <p>Get through all 50 words as quickly and accurately as possible.</p>
            <p>You may use either the buttons or the arrow keys.</p>
        </BodyTemplate>

        <FooterTemplate>
            <Button Color="ButtonColor.Primary" @onclick="@(() => rules.HideAsync())">
                @if (showingInitialRules){
                    <p style="margin:0">Start Test</p>
                }
                else{
                    <p style="margin:0">Close</p>
                }
            </Button>
        </FooterTemplate>
    </Modal>

@if (dayCompleteMessage != null){
    <Toast ToastMessage="@dayCompleteMessage" AutoHide="true" Delay="6000" Class="position-fixed top-50 end-0 translate-middle-y me-3" Hidden="OnDayCompleteToastHidden" />
}

<button class="rulesButton" @onclick="ShowRules">?</button>
@if (gameState == GameState.Loading){
    <h3>Loading...</h3>
}
else if (gameState == GameState.Rules){
    <p></p>
}
else if (gameState == GameState.Playing)
{
    <div class="stroopGame">
        <div class="upperInfo">
            <p>Progress @(game.CurrentQuestion) / 50</p>
            <p>Score: @game.Score</p>
            <p>Time: @TimeSpan.FromSeconds(elapsedSeconds).ToString(@"mm\:ss")</p>
        </div>

        <h1 class="stroopWord" style="color:@GetCssColor(game.CurrentWord.Color)">
            @game.CurrentWord.Text
        </h1>

        <div class="stroopButtonGroup">
            <div class="stroopButtonGroup1">
                <button class="stroopButton stroopRed @GetFlashClass(StroopColor.Red)"
                        @onclick="() => Submit(StroopColor.Red)">
                    <span id="rotateText">Red</span>
                </button>
                <button class="stroopButton stroopBlue @GetFlashClass(StroopColor.Blue)"
                        @onclick="() => Submit(StroopColor.Blue)">
                    <span id="rotateText">Blue</span>
                </button>
            </div>
            <div class="stroopButtonGroup2">
                <button class="stroopButton stroopGreen @GetFlashClass(StroopColor.Green)"
                        @onclick="() => Submit(StroopColor.Green)">
                    <span id="rotateText">Green</span>
                </button>
                <button class="stroopButton stroopYellow @GetFlashClass(StroopColor.Yellow)"
                        @onclick="() => Submit(StroopColor.Yellow)">
                    <span id="rotateText">Yellow</span>
                </button>
            </div>
        </div>
    </div>
}
else if (gameState == GameState.Results){
    <Tabs EnableFadeEffect="true">
        <Tab Title="Results" Active="true">
            <Content>
                <div class="resultsContainer">
                    <h1>Finished!</h1>                    
                    <h2>Time - @TimeSpan.FromSeconds(elapsedSeconds).ToString(@"mm\:ss")</h2>
                    <h2>Score: @game.Score / 50</h2>
                </div>
            </Content>
        </Tab>
    </Tabs>
}

@code {

    private StroopGame game = new();
    private Modal rules = default!;
    private DotNetObjectReference<Stroop>? _dotNetRef;
    private bool modalShown;
    private int elapsedSeconds;
    private bool _resetting = false;
    private CancellationTokenSource cts = new();
    private StroopColor? _flashColor = null;
    private GameState gameState = GameState.Loading;
    private TYB_AMI.Services.UserStats? _stats;
    private bool showingInitialRules = true;
    private int _cycleDayPlayed;
    private string _serverDate = "";
    private bool _dayAlreadyCompleteAtStart;
    private ToastMessage? dayCompleteMessage;
    private enum GameState { Loading, Rules, Playing, Results }

    protected override void OnInitialized(){
        game.Reset();
        gameState = GameState.Rules;
    }

    protected override async Task OnInitializedAsync(){
        var statsAtStart = await AuthService.GetStatsAsync();
        var time = await AuthService.GetServerTimeAsync();
        _serverDate = time?.ServerDate ?? "";

        if (statsAtStart != null){
            _cycleDayPlayed = statsAtStart.CycleDay;
            _dayAlreadyCompleteAtStart = TYB_AMI.Services.TYBAuthService.IsDailyRequirementsMet(statsAtStart, _cycleDayPlayed, _serverDate);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender){
        if (firstRender && !modalShown){
            modalShown = true;

            _dotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("stroopKeys.register", _dotNetRef);

            await Task.Yield();
            await rules.ShowAsync();
        }
    }

    [JSInvokable]
    public async Task OnGlobalKeyDown(string key, bool repeat){
        if (repeat) return;
        if (gameState != GameState.Playing) return;

        switch (key){
            case "ArrowUp":
                await Submit(StroopColor.Red);
                break;
            case "ArrowLeft":
                await Submit(StroopColor.Green);
                break;
            case "ArrowRight":
                await Submit(StroopColor.Blue);
                break;
            case "ArrowDown":
                await Submit(StroopColor.Yellow);
                break;
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task OnRulesHidden(){
        if (showingInitialRules){
            showingInitialRules = false;

            elapsedSeconds = 0;
            cts = new CancellationTokenSource();
            gameState = GameState.Playing;

            _ = RunTimer();

            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task RunTimer(){
        var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        try{
            while (await timer.WaitForNextTickAsync(cts.Token)){
                elapsedSeconds++;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException){}
        timer.Dispose();
    }

    private async Task Submit(StroopColor color){
        Console.WriteLine($"Submit: {color}, Question = {game.CurrentQuestion}");
        bool isCorrect = color == game.CurrentWord.Color;
        game.SubmitAnswer(color);

        if (game.Finished){
            cts.Cancel();
            _flashColor = null;
            gameState = GameState.Results;
            _stats = await AuthService.SubmitScoreAsync("stroop", game.Score, elapsedSeconds);
            AuthService.NotifyStatsChanged();

            if (!_dayAlreadyCompleteAtStart && _stats != null
                && TYB_AMI.Services.TYBAuthService.IsDailyRequirementsMet(_stats, _cycleDayPlayed, _serverDate)){
                ShowDayCompleteToast();
            }

            await InvokeAsync(StateHasChanged);
            return;
        }

        if (isCorrect){
            if (_flashColor == color){
                _flashColor = null;
                _resetting = true;

                await InvokeAsync(StateHasChanged);
                await Task.Delay(16);

                _resetting = false;
            }

            _flashColor = color;
            await InvokeAsync(StateHasChanged);
            await Task.Delay(600);
            _flashColor = null;
            await InvokeAsync(StateHasChanged);
        }
    }

    private string GetCssColor(StroopColor color){
        return color switch{
            StroopColor.Red    => "red",
            StroopColor.Blue   => "blue",
            StroopColor.Green  => "green",
            StroopColor.Yellow => "gold",
            _ => "black"
        };
    }

    public async ValueTask DisposeAsync(){
        cts.Cancel();
        cts.Dispose();

        if (_dotNetRef != null){
            await JS.InvokeVoidAsync("stroopKeys.unregister");
            _dotNetRef.Dispose();
        }
    }
    private string GetFlashClass(StroopColor color){
        if (_flashColor == color)
            return _resetting ? "flash-reset" : $"flash-{GetColorName(color)}";
        return "";
    }

    private string GetColorName(StroopColor color) => color switch{
        StroopColor.Red    => "red",
        StroopColor.Blue   => "blue",
        StroopColor.Green  => "green",
        StroopColor.Yellow => "yellow",
        _ => ""
    };
    private async Task ShowRules(){
        showingInitialRules = false;
        await rules.ShowAsync();
    }

    private void ShowDayCompleteToast(){
        dayCompleteMessage = new ToastMessage{
            Type = ToastType.Success,
            Title = $"Day {_cycleDayPlayed} Completed!",
            Message = $"Your streak is now {_stats!.Streak.Current} days!"
        };
    }

    private void OnDayCompleteToastHidden(ToastEventArgs args){
        dayCompleteMessage = null;
    }
}