@inject TYB_AMI.Services.TYBAuthService AuthService

<p>Training day: <strong>@_stats.CycleDay</strong> / 8</p>
<p>
    Today's required games:
    @if (_stats.CycleDay == 1 || _stats.CycleDay == 8)
    {
        <strong>Stroop + Memory</strong>
    }
    else
    {
        <strong>Math</strong>
    }
</p>

@code {
    private TYB_AMI.Services.UserStats? _stats;
    protected override async Task OnInitializedAsync(){
        for (int i = 0; i < 50 && !AuthService.IsAuthenticated; i++){
            await Task.Delay(100);
        }

        if (AuthService.IsAuthenticated){
            _stats = await AuthService.GetStatsAsync();
            StateHasChanged();
        }
    }
}