@using TYB_AMI.Layout.Components
@inherits LayoutComponentBase
@inject TYB_AMI.Services.TYBAuthService AuthService

<div class="app">
    <SideBar />
    <div class="rightHalf">
        <TopBar />
        <main class="pageContent">
            @Body
        </main>
    </div>

</div>

<RadzenComponents />



@code {

    protected override async Task OnInitializedAsync()
    {
        await AuthService.InitializeAsync();
    }
} 












