@namespace TYB_AMI.Layout.Components
@inject TYB_AMI.Services.TYBAuthService AuthService
@implements IDisposable
@inject HttpClient Http

@using BlazorBootstrap

<div class="sideBar">
    <div class="sidebarLogo">
        <img src="AMI_Logo.svg" alt="Train Your Brain Logo" />
    </div>

    @* <div class="container2"> *@
        <div class="dayWeekContainer">
            @if (_stats != null){
                <p class="weekLabel">Week @((int)Math.Ceiling(_stats.CycleDay / 7.0))</p>
            }
            <div class="dailyButton">
                <strong><p class="dayCounter">Day @(_stats?.CycleDay.ToString() ?? "—")</p></strong>
                @if (_todayComplete){
                    <p class="countdown">@_countdownDisplay</p>
                }  
            </div>
        </div>

        <nav class="sidebarNav">        
            @if (!_todayComplete){
                <NavLink href="/daily" class="specialDayButton" draggable="false">
                    <div class="dayIconCircle">
                        <i class="bi bi-play-fill"></i>
                    </div>
                    <span id="beginDay">Begin Day @(_stats?.CycleDay.ToString() ?? "—")</span>
                </NavLink>
            }
            <NavLink href="/" Match="NavLinkMatch.All" class="sidebarButton" draggable="false">
                <div class="iconCircle">
                    <i class="bi bi-house-door-fill"></i>
                </div>
                <span>Home</span>
            </NavLink>

            <NavLink href="/stats" class="sidebarButton" ActiveClass="active" draggable="false">
                <div class="iconCircle">
                    <i class="bi bi-bar-chart-fill"></i>
                </div>
                <span>Stats</span>
            </NavLink>

            <NavLink href="/practice" class="sidebarButton" ActiveClass="active" draggable="false">
                <div class="iconCircle">
                    <i class="bi bi-lightning-fill"></i>
                </div>
                <span>Practice</span>
            </NavLink>

            <NavLink href="/resources" class="sidebarButton" ActiveClass="active" draggable="false">
                <div class="iconCircle">
                    <i class="bi bi-book-half"></i>
                </div>
                <span>Resources</span>
            </NavLink>

        </nav>
    @* </div> *@

</div>
@code {
    private TYB_AMI.Services.UserStats? _stats;
    private bool _todayComplete = false;
    private string _countdownDisplay = "";
    private System.Timers.Timer? _countdownTimer;
    private int _secondsRemaining = 0;
    private string _serverDate = "";

    protected override async Task OnInitializedAsync(){
        AuthService.OnStatsChanged += OnStatsUpdated;
        for (int i = 0; i < 50 && !AuthService.IsAuthenticated; i++){
            await Task.Delay(100);
        }

        if (AuthService.IsAuthenticated){
            _stats = await AuthService.GetStatsAsync();
            await FetchSecondsUntilMidnight();
            UpdateTodayComplete();
            StartCountdownTimer();
            StateHasChanged();
        }
    }

    private async Task FetchSecondsUntilMidnight(){
        try{
            var response = await Http.GetAsync("https://abundantminds.org/wp-json/tyb/v1/time");
            if (response.IsSuccessStatusCode){
                var data = await response.Content.ReadFromJsonAsync<TimeResponse>();
                _secondsRemaining = data?.SecondsUntilMidnight ?? 0;
                _serverDate       = data?.ServerDate ?? "";    // ← new
            }
        }
        catch{
            _secondsRemaining = 0;
            _serverDate       = "";
        }
    }

    private void UpdateTodayComplete(){
        if (_stats == null || string.IsNullOrEmpty(_serverDate)){
            _todayComplete = false;
            return;
        }
        _todayComplete = _stats.CompletedDates.Contains(_serverDate);
    }


    private void StartCountdownTimer(){
        _countdownTimer?.Dispose();
        _countdownTimer = new System.Timers.Timer(1000);
        _countdownTimer.Elapsed += (_, _) =>
        {
            if (_secondsRemaining > 0){
                _secondsRemaining--;
            }

            if (_secondsRemaining <= 0 && _todayComplete){
                // Server midnight hit — new day has opened
                _todayComplete = false;
                _secondsRemaining = 0;
            }

            UpdateCountdownDisplay();
            InvokeAsync(StateHasChanged);
        };
        _countdownTimer.Start();
        UpdateCountdownDisplay();
    }

    private void UpdateCountdownDisplay(){
        if (!_todayComplete || _secondsRemaining <= 0){
            _countdownDisplay = "";
            return;
        }

        int hours   = _secondsRemaining / 3600;
        int minutes = (_secondsRemaining % 3600) / 60;
        int seconds = _secondsRemaining % 60;

        _countdownDisplay = $"{hours:D2}:{minutes:D2}:{seconds:D2}";
    }

    private async void OnStatsUpdated(){
        _stats = await AuthService.GetStatsAsync();
        await FetchSecondsUntilMidnight();
        UpdateTodayComplete();
        UpdateCountdownDisplay();
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose(){
        AuthService.OnStatsChanged -= OnStatsUpdated;
        _countdownTimer?.Dispose();
    }

    private class TimeResponse{
        [System.Text.Json.Serialization.JsonPropertyName("seconds_until_midnight")]
        public int SecondsUntilMidnight { get; set; }
        [System.Text.Json.Serialization.JsonPropertyName("server_date")]
        public string ServerDate { get; set; } = "";    // ← new
    }


}