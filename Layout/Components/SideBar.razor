    <div class="sidebar-logo">
        @* <img src="logo.png" alt="Train Your Brain Logo" /> *@
        logo
    </div>

    <nav class="sidebarNav">
        <NavLink href="/daily" class="dailyButton">
            <strong>Day 1</strong>
        </NavLink>
        <NavLink href="/" Match="NavLinkMatch.All" class="sidebarButton" draggable="false">
            <div class="iconCircle">
                <i class="bi bi-house-door-fill"></i>
