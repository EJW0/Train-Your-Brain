@using TYB_AMI.Layout.Components
@inject TYB_AMI.Services.TYBAuthService AuthService

<div class="topBar">
    <div class="greeting">
        @if (_loading){
            <p></p>
        }
        else if (AuthService.IsAuthenticated){
            <span>Hello, @AuthService.DisplayName!</span>
        }
        else{
            <span>Hello, guest!</span>
        }
    </div>

</div>

@code {
    private bool _loading = true;

    protected override async Task OnInitializedAsync(){
        for (int i = 0; i < 50 && !AuthService.IsAuthenticated; i++){
            await Task.Delay(100);
        }

        _loading = false;
        
    }
}


