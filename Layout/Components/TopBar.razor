@using TYB_AMI.Layout.Components
@inject TYB_AMI.Services.TYBAuthService AuthService

<Modal @ref="creditsModal"
       Title="Credits"
       UseStaticBackdrop="true"
       CloseOnEscape="true"
       IsVerticallyCentered="true">

    <BodyTemplate>
        <p>2026 Abundant Minds Initiative</p>

        <p>This application was made by Emma Wang (emma24wang@gmail.com), Zoey Lapidus, and Simon Lapidus</p>

        <p>GitHub Repo: https://github.com/EJW0/Train-Your-Brain</p>
    </BodyTemplate>
</Modal>
<Modal @ref="bugModal"
       Title="Bug Report"
       UseStaticBackdrop="true"
       CloseOnEscape="true"
       IsVerticallyCentered="true">

    <BodyTemplate>
        <p>Found something that doesn't seem right?</p>
        <p>Pleas report it through this link [google form]</p>

        <ul>Known bugs:
            <li>For some Firefox users, inputting the same answer in a row during the Math exercise brings up the prompt, "Please input a number".</li>
        </ul>
    </BodyTemplate>
</Modal>

<div class="topBar">
    <div class="greeting">
        @if (_loading){
            <p></p>
        }
        else if (AuthService.IsAuthenticated){
            <span>Hello, @AuthService.DisplayName!</span>
        }
        else{
            <span>Hello, guest!</span>
        }
    </div>
    <div class="miscButtons">
        <button class="credits" @onclick ="ShowCredits">
            <p class="creditsButton">©</p>
        </button>
        @* <button class="credits" @onclick ="ShowBug">
            <p class="creditsButton bi bi-bug"></p>
        </button> *@
    </div>

</div>

@code {
    private bool _loading = true;
    private Modal creditsModal = default!;
    private Modal bugModal = default!;



    protected override async Task OnInitializedAsync(){
        for (int i = 0; i < 50 && !AuthService.IsAuthenticated; i++){
            await Task.Delay(100);
        }
        _loading = false;
        
    }
    private async Task ShowCredits(){
        await creditsModal.ShowAsync();
    }
    private async Task ShowBug(){
        await bugModal.ShowAsync();
    }
}


